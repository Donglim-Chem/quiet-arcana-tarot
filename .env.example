# Tarot AI backend configuration
#
# On the server, copy this file to /etc/tarot-ai.env, fill in the real
# values, and lock it down:  sudo chown root:root /etc/tarot-ai.env && sudo chmod 600 /etc/tarot-ai.env
# NEVER commit the filled-in file or your API key to version control.

# Your LLM API key (required). Keep this secret.
TAROT_API_KEY=

# OpenAI-compatible API base URL (no trailing slash).
TAROT_API_BASE=https://api.xiaomimimo.com/v1

# Model name used for readings.
TAROT_MODEL=mimo-v2.6-pro

# Local port the backend proxy listens on.
TAROT_PORT=8012

# Per-IP rate limit (requests per hour).
TAROT_RATE_PER_HOUR=12

# Global rate limit (requests per day).
TAROT_GLOBAL_PER_DAY=250